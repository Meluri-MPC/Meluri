{
  "name": "@velumx/mpc-service",
  "version": "0.1.0",
  "private": true,
  "description": "VelumX MPC Service — Threshold Signature Scheme implementation for Stacks",
  "scripts": {
    "spike": "npx tsx src/tss/spike.ts",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "test": "npx tsx test/chaos/chaos.spec.ts && npx tsx test/dkg/dkg.protocol.spec.ts && npx tsx test/kms/kms.spec.ts && npx tsx test/load/load-test.spec.ts && npx tsx test/recovery/recovery.spec.ts && npx tsx test/round-trip/round-trip.spec.ts && npx tsx test/signing/signing.protocol.spec.ts && npx tsx test/signing-ceremony/signing-ceremony.spec.ts && npx tsx test/sync/sync.spec.ts && npx tsx test/topology/topology.spec.ts && npx tsx test/transport/transport.spec.ts",
    "test:chaos": "npx tsx test/chaos/chaos.spec.ts",
    "test:dkg": "npx tsx test/dkg/dkg.protocol.spec.ts",
    "test:kms": "npx tsx test/kms/kms.spec.ts",
    "test:load": "npx tsx test/load/load-test.spec.ts",
    "test:recovery": "npx tsx test/recovery/recovery.spec.ts",
    "test:round-trip": "npx tsx test/round-trip/round-trip.spec.ts",
    "test:signing": "npx tsx test/signing/signing.protocol.spec.ts",
    "test:signing-ceremony": "npx tsx test/signing-ceremony/signing-ceremony.spec.ts",
    "test:sync": "npx tsx test/sync/sync.spec.ts",
    "test:topology": "npx tsx test/topology/topology.spec.ts",
    "test:transport": "npx tsx test/transport/transport.spec.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^26.0.1",
    "@types/ws": "^8.18.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
