{
  "name": "@velumx/mpc",
  "version": "0.1.0",
  "description": "VelumX MPC SDK — Stacks-native embedded wallet. Like Privy for Stacks.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./wallets": {
      "import": {
        "types": "./dist/wallets/index.d.ts",
        "default": "./dist/wallets/index.mjs"
      },
      "require": {
        "types": "./dist/wallets/index.d.cts",
        "default": "./dist/wallets/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.mjs"
      },
      "require": {
        "types": "./dist/ui/index.d.cts",
        "default": "./dist/ui/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.mjs"
      },
      "require": {
        "types": "./dist/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    },
    "./cdn": "./dist/cdn/velumx.iife.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ],
      "wallets": [
        "./dist/wallets/index.d.ts"
      ],
      "ui": [
        "./dist/ui/index.d.ts"
      ],
      "native": [
        "./dist/native/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:cdn": "tsup --config tsup.iife.ts",
    "build:native": "tsup --config tsup.native.ts",
    "build:all": "tsup && tsup --config tsup.iife.ts && tsup --config tsup.native.ts",
    "build:dev": "tsup --config tsup.dev.ts",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "tsup",
    "size": "size-limit",
    "size:cdn": "gzip -c dist/cdn/velumx.iife.js | wc -c",
    "test": "npx tsx test/ui/components.spec.tsx && npx tsx test/wallets/connectors.spec.ts && npx tsx test/wallets/detection.spec.ts && npx tsx test/wallets/discovery.spec.ts && npx tsx test/wallets/events.spec.ts && npx tsx test/wallets/network.spec.ts && npx tsx test/wallets/persistence.spec.ts && npx tsx test/wallets/signing.spec.ts",
    "test:ui": "npx tsx test/ui/components.spec.tsx",
    "test:connectors": "npx tsx test/wallets/connectors.spec.ts",
    "test:detection": "npx tsx test/wallets/detection.spec.ts",
    "test:discovery": "npx tsx test/wallets/discovery.spec.ts",
    "test:events": "npx tsx test/wallets/events.spec.ts",
    "test:network": "npx tsx test/wallets/network.spec.ts",
    "test:persistence": "npx tsx test/wallets/persistence.spec.ts",
    "test:signing": "npx tsx test/wallets/signing.spec.ts"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/secp256k1": "^3.1.0",
    "@stacks/encryption": "^7.6.0",
    "@stacks/network": "^7.6.0",
    "@stacks/transactions": "^7.6.0",
    "@turnkey/http": "^6.3.0",
    "@turnkey/iframe-stamper": "^2.11.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "jsdom": "^25.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "size-limit": [
    {
      "name": "Core (ESM)",
      "path": "dist/index.mjs",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "name": "React (ESM)",
      "path": "dist/react/index.mjs",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "name": "UI + Core (ESM)",
      "path": [
        "dist/index.mjs",
        "dist/react/index.mjs"
      ],
      "limit": "100 KB",
      "gzip": true
    },
    {
      "name": "IIFE (CDN)",
      "path": "dist/cdn/velumx.iife.js",
      "limit": "120 KB",
      "gzip": true
    }
  ],
  "keywords": [
    "stacks",
    "mpc",
    "wallet",
    "embedded",
    "web3",
    "velumx"
  ],
  "license": "MIT"
}
