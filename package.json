{
  "name": "velumx-mpc",
  "private": true,
  "description": "VelumX MPC — Stacks-native embedded wallet infrastructure. Like Privy for Stacks.",
  "scripts": {
    "dev": "pnpm --filter @velumx/api dev",
    "build": "pnpm --filter \"./packages/sdk\" build && pnpm --filter @velumx/mpc-service build",
    "sdk:dev": "pnpm --filter \"./packages/sdk\" dev",
    "sdk:build": "pnpm --filter \"./packages/sdk\" build",
    "sdk:lint": "pnpm --filter \"./packages/sdk\" lint",
    "sdk:size": "pnpm --filter \"./packages/sdk\" size",
    "mpc:dev": "pnpm --filter @velumx/mpc-service dev",
    "mpc:build": "pnpm --filter @velumx/mpc-service build",
    "dashboard:dev": "pnpm --filter @velumx/dashboard dev",
    "demo:dev": "pnpm --filter @velumx/demo dev",
    "db:migrate": "pnpm --filter @velumx/api db:migrate",
    "db:generate": "pnpm --filter @velumx/api db:generate",
    "db:studio": "pnpm --filter @velumx/api db:studio",
    "test": "pnpm --filter \"./apps/mpc\" test && pnpm --filter \"./packages/sdk\" test",
    "test:mpc": "pnpm --filter \"./apps/mpc\" test",
    "test:sdk": "pnpm --filter \"./packages/sdk\" test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "tmp": ">=0.2.6",
      "protobufjs": ">=7.6.1",
      "postcss": ">=8.5.10"
    }
  }
}
