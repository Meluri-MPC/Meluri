{
  "name": "velumx-mpc",
  "private": true,
  "description": "VelumX MPC — Stacks-native embedded wallet infrastructure. Like Privy for Stacks.",
  "scripts": {
    "dev": "pnpm --filter @velumx/api dev",
    "build": "pnpm --filter @velumx/mpc build",
    "sdk:dev": "pnpm --filter @velumx/mpc dev",
    "sdk:build": "pnpm --filter @velumx/mpc build",
    "sdk:lint": "pnpm --filter @velumx/mpc lint",
    "sdk:size": "pnpm --filter @velumx/mpc size",
    "dashboard:dev": "pnpm --filter @velumx/dashboard dev",
    "demo:dev": "pnpm --filter @velumx/demo dev",
    "db:migrate": "pnpm --filter @velumx/api db:migrate",
    "db:generate": "pnpm --filter @velumx/api db:generate",
    "db:studio": "pnpm --filter @velumx/api db:studio",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "@nestjs/microservices": ">=11.1.19",
      "@grpc/grpc-js": ">=1.14.4",
      "tmp": ">=0.2.6",
      "vite": ">=6.4.3",
      "protobufjs": ">=7.6.1"
    }
  }
}
